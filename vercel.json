{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog/22-a-day", "destination": "/blog/the-17-point-5", "permanent": true },
    { "source": "/blog/22-a-day.html", "destination": "/blog/the-17-point-5", "permanent": true }
  ],
  "rewrites": [
    { "source": "/social-quotes/:path*", "destination": "/public/social-quotes/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    }
  ]
}
